{
  "schema": 1,
  "description": "Git remote normalization: every input maps to one canonical lowercase host/path key, or is rejected when expected is null. Shared contract between the nexer-ai bootstrap and marketplace CI.",
  "cases": [
    { "input": "https://github.com/acme/website", "expected": "github.com/acme/website", "note": "Canonical form: host/path without scheme." },
    { "input": "https://github.com/acme/website.git", "expected": "github.com/acme/website", "note": "The .git suffix is stripped." },
    { "input": "https://github.com/acme/website/", "expected": "github.com/acme/website", "note": "Trailing slash is stripped." },
    { "input": "https://github.com/acme/website.git/", "expected": "github.com/acme/website", "note": "Trailing slash and .git suffix together." },
    { "input": "https://GitHub.com/Acme/WebSite.git", "expected": "github.com/acme/website", "note": "Host and path are lowercased." },
    { "input": "https://jdoe@github.com/acme/website.git", "expected": "github.com/acme/website", "note": "User name is stripped." },
    { "input": "https://jdoe:example-password@github.com/acme/website.git", "expected": "github.com/acme/website", "note": "User and token are stripped." },
    { "input": "http://github.com/acme/website", "expected": "github.com/acme/website", "note": "The scheme is not part of the key, so http and https match." },
    { "input": "https://github.com:443/acme/website", "expected": "github.com/acme/website", "note": "Ports are dropped from https URLs." },
    { "input": "https://github.com/acme/website.git?ref=main#readme", "expected": "github.com/acme/website", "note": "Query string and fragment are dropped." },
    { "input": "  https://github.com/acme/website.git\t", "expected": "github.com/acme/website", "note": "Surrounding whitespace is ignored." },
    { "input": "git@github.com:acme/website.git", "expected": "github.com/acme/website", "note": "scp-like SSH form." },
    { "input": "ssh://git@github.com/acme/website.git", "expected": "github.com/acme/website", "note": "SSH URL form." },
    { "input": "ssh://git@github.com:22/acme/website.git", "expected": "github.com/acme/website", "note": "Ports are dropped from SSH URLs." },
    { "input": "https://dev.azure.com/acme/Website/_git/website-api", "expected": "dev.azure.com/acme/website/_git/website-api", "note": "Azure DevOps HTTPS keeps org/project/_git/repo." },
    { "input": "https://acme@dev.azure.com/acme/Website/_git/website-api", "expected": "dev.azure.com/acme/website/_git/website-api", "note": "Azure DevOps clone URL with the org as user name." },
    { "input": "https://acme.visualstudio.com/Website/_git/website-api", "expected": "dev.azure.com/acme/website/_git/website-api", "note": "Legacy org.visualstudio.com is rewritten to dev.azure.com/org." },
    { "input": "https://acme.visualstudio.com/DefaultCollection/Website/_git/website-api", "expected": "dev.azure.com/acme/website/_git/website-api", "note": "Legacy DefaultCollection segment is dropped." },
    { "input": "git@ssh.dev.azure.com:v3/acme/Website/website-api", "expected": "dev.azure.com/acme/website/_git/website-api", "note": "Azure DevOps SSH v3 maps to the HTTPS key." },
    { "input": "ssh://git@ssh.dev.azure.com:22/v3/acme/Website/website-api", "expected": "dev.azure.com/acme/website/_git/website-api", "note": "Azure DevOps SSH URL form with port maps to the HTTPS key." },
    { "input": "acme@vs-ssh.visualstudio.com:v3/acme/Website/website-api", "expected": "dev.azure.com/acme/website/_git/website-api", "note": "Legacy Azure DevOps SSH host maps to the HTTPS key." },
    { "input": "https://dev.azure.com/acme/My%20Project/_git/portal", "expected": "dev.azure.com/acme/my project/_git/portal", "note": "Percent-encoded segments are decoded." },
    { "input": "https://dev.azure.com/acme/My Project/_git/portal", "expected": "dev.azure.com/acme/my project/_git/portal", "note": "A literal space gives the same key as %20." },
    { "input": "git@ssh.dev.azure.com:v3/acme/My%20Project/portal", "expected": "dev.azure.com/acme/my project/_git/portal", "note": "Decoding also applies to Azure DevOps SSH." },
    { "input": "https://gitlab.com/acme/platform/api.git", "expected": "gitlab.com/acme/platform/api", "note": "Generic host with nested groups keeps the full path." },
    { "input": "git@gitlab.com:acme/platform/api.git", "expected": "gitlab.com/acme/platform/api", "note": "Generic host, scp-like SSH form." },
    { "input": "https://jdoe@bitbucket.org/acme/website.git", "expected": "bitbucket.org/acme/website", "note": "Generic host with user name." },
    { "input": "git@bitbucket.org:acme/website.git", "expected": "bitbucket.org/acme/website", "note": "Generic host, scp-like SSH form." },
    { "input": "", "expected": null, "note": "Empty input is rejected." },
    { "input": "   ", "expected": null, "note": "Whitespace-only input is rejected." },
    { "input": "C:\\repos\\website", "expected": null, "note": "Windows path is a local remote, rejected." },
    { "input": "C:/repos/website", "expected": null, "note": "Drive letter is not an scp-like host." },
    { "input": "/srv/git/website.git", "expected": null, "note": "Absolute POSIX path is a local remote, rejected." },
    { "input": "../website", "expected": null, "note": "Relative path is a local remote, rejected." },
    { "input": "file:///C:/repos/website", "expected": null, "note": "file:// URLs are local remotes, rejected." },
    { "input": "ftp://github.com/acme/website", "expected": null, "note": "Only http, https, ssh and git schemes are accepted." },
    { "input": "not a remote", "expected": null, "note": "Garbage is rejected, not guessed." },
    { "input": "https://", "expected": null, "note": "URL without host is rejected." },
    { "input": "https://github.com/", "expected": null, "note": "URL without path is rejected." },
    { "input": "buildserver:website", "expected": null, "note": "Hosts must be fully qualified (contain a dot), so a dotless host is rejected." }
  ]
}
