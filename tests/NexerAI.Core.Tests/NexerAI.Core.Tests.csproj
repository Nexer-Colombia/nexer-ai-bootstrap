<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Test names use underscores for readability. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <PackageReference Include="xunit.v3" />
    <ProjectReference Include="..\..\src\NexerAI.Core\NexerAI.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared test vectors: the contract with marketplace CI (see README). -->
    <None Include="..\..\test-vectors\*.json" LinkBase="test-vectors" CopyToOutputDirectory="PreserveNewest" />
    <!-- Status line input recorded from Claude Code (see StatusLineInputParserTests). -->
    <None Update="StatusLine\Samples\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Claude Code output and config recorded in an isolated config (see ClaudeCode tests). -->
    <None Update="ClaudeCode\Samples\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
